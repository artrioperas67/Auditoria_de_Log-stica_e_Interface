body {
  background-color: #1e1e1e;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
  padding: 30px;
}

h1 {
  color: #00aaff;
  margin-bottom: 20px;
}

button {
  background-color: #005577;
  color: white;
  border: none;
  padding: 12px 20px;
  font-size: 16px;
  border-radius: 8px;
  cursor: pointer;
}

button:hover {
  background-color: #0088cc;
}

#relatorio {
  margin-top: 30px;
  background-color: #2b2b2b;
  padding: 20px;
  border-radius: 10px;
  width: 70%;
  margin-left: auto;
  margin-right: auto;
  text-align: left;
}

.caixa {
  background-color: #3a3a3a;
  padding: 10px;
  margin-bottom: 10px;
  border-left: 5px solid #00aaff;
}

.erro {
  color: red;
  font-weight: bold;
  font-size: 18px;
}
